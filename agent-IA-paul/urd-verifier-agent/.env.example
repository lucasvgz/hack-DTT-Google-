# LLM Configuration
# Provider choices: auto | vertexai | gemini | openai | anthropic | offline
URD_LLM_PROVIDER=auto
URD_LLM_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# GCP / Vertex AI / Cloud Storage (Cloud Run production)
GOOGLE_CLOUD_PROJECT=
URD_VERTEX_PROJECT=
URD_VERTEX_LOCATION=europe-west1
URD_GCS_BUCKET=
URD_GCS_PREFIX=urd-sessions

# Verification tolerances
URD_ARITHMETIC_TOLERANCE=1.0
URD_VARIATION_TOLERANCE_PCT=0.15
URD_MATERIALITY_THRESHOLD_EUR=500000.0
URD_MATERIALITY_THRESHOLD_PCT=0.5

# Storage & API
URD_DATA_DIR=
URD_API_HOST=0.0.0.0
URD_API_PORT=8080
URD_CORS_ORIGINS=*
